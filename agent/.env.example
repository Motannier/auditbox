# Local service: keep loopback-only because the agent has no authentication.
AUDITBOX_AGENT_HOST=127.0.0.1
AUDITBOX_AGENT_PORT=18765
AUDITBOX_AGENT_LOCAL_USER_ID=local-user
AUDITBOX_AGENT_ENVIRONMENT=development

AUDITBOX_AGENT_DATABASE_URL=sqlite:///data/agent.sqlite3
AUDITBOX_AGENT_STANDARD_MODEL=qwen3.5-2b
AUDITBOX_AGENT_MODEL_BASE_URL=http://127.0.0.1:18081/v1
AUDITBOX_AGENT_STANDARD_MODEL_BASE_URL=http://127.0.0.1:18081/v1
AUDITBOX_AGENT_MODEL_BACKEND=openai
AUDITBOX_AGENT_MODEL_API_KEY=
AUDITBOX_AGENT_MODEL_EXTRA_BODY={}
# 标准和增强模式共用服务器 CUDA llama.cpp 2B；分别关闭和开启思考。
AUDITBOX_AGENT_MODEL_CONTEXT_WINDOW_TOKENS=32768
# 仅 Ollama 后端使用此项。
AUDITBOX_AGENT_OLLAMA_KEEP_ALIVE=30m
AUDITBOX_AGENT_STANDARD_MODEL_WARMUP_ENABLED=true
AUDITBOX_AGENT_STANDARD_MODEL_WARMUP_TIMEOUT_SECONDS=120
AUDITBOX_AGENT_TOOL_CALL_LIMIT=12
# 首次初始化执行总开关，默认模型问答；之后在助手插件设置中切换并持久化。
AUDITBOX_AGENT_EXECUTION_ENABLED=false
AUDITBOX_AGENT_QA_FILE_CONTEXT_CHARACTERS=6000
# Loopback-only Gateway endpoint used to share the browser's live terminal.
AUDITBOX_AGENT_GATEWAY_INTERNAL_URL=http://127.0.0.1:18080
AUDITBOX_AGENT_TERMINAL_TOOL_TIMEOUT_SECONDS=20

# Preserved but disabled until a compatible embedding service is available.
AUDITBOX_AGENT_KNOWLEDGE_ENABLED=false
AUDITBOX_AGENT_KNOWLEDGE_CHROMA_DIRECTORY=data/chromadb
AUDITBOX_AGENT_KNOWLEDGE_COLLECTION=auditbox-knowledge
AUDITBOX_AGENT_EMBEDDING_MODEL=
AUDITBOX_AGENT_EMBEDDING_BASE_URL=
AUDITBOX_AGENT_EMBEDDING_API_KEY=
AUDITBOX_AGENT_EMBEDDING_DIMENSIONS=1024
AUDITBOX_AGENT_KNOWLEDGE_UPLOAD_DIRECTORY=data/uploads
AUDITBOX_AGENT_KNOWLEDGE_UPLOAD_ALLOWED_EXTENSIONS=[".txt",".md",".html",".htm",".pdf"]

# Every tool named here is both allowlisted and confirmation-required.
AUDITBOX_AGENT_MCP_SERVERS=[]
AUDITBOX_AGENT_SKILL_DIRECTORY=data/skills
AUDITBOX_AGENT_CONVERSATION_FILE_DIRECTORY=data/conversations
AUDITBOX_AGENT_CONVERSATION_FILE_MAX_BYTES=5242880
AUDITBOX_AGENT_CONVERSATION_FILE_MAX_FILES=10
AUDITBOX_AGENT_CONVERSATION_FILE_MAX_CHARACTERS=1000000
AUDITBOX_AGENT_CONVERSATION_FILE_READ_CHARACTERS=4000
AUDITBOX_AGENT_WORKSPACE_DIRECTORY=data/workspace
AUDITBOX_AGENT_GENERATED_FILE_DIRECTORY=data/generated
AUDITBOX_AGENT_SQL_TOOL_DATABASE_URL=sqlite:///data/tool-workspace.sqlite3
AUDITBOX_AGENT_TELEMETRY_ENABLED=false
