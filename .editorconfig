root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{js,jsx,mjs,json,yaml,yml,css,svg}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[agent/defaults/skills/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
